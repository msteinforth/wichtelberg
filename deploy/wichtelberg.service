[Unit]
Description=Wichtelberg (Wein-Wichteln)
After=network-online.target

[Service]
Type=simple
User=wichtelberg
WorkingDirectory=/opt/wichtelberg
EnvironmentFile=/etc/wichtelberg.env
ExecStart=/usr/bin/node src/main.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wichtelberg/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
